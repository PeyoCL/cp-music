# Spotify API Credentials
# Obtén las credenciales en: https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id_here
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret_here
# IMPORTANTE: Agrega exactamente esta URI en tu Spotify App → Settings → Redirect URIs
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# YouTube Music Auth
# Ruta al archivo generado por 'python -m cpmusic setup-auth'
YTMUSIC_AUTH_FILE=headers_auth.json
